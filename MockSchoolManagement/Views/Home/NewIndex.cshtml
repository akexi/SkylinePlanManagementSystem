@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager
@{
    ViewBag.Title = "首页 - 项目计划管理系统";
    var appUser = await _userManager.GetUserAsync(User);
}

<!-- 欢迎区 -->
<div class="card shadow-sm mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">

        <div>
            <h5 class="mb-1">👋 欢迎回来，@appUser.Name</h5>
            <div class="text-muted">
                今天是 @DateTime.Now.ToString("yyyy年MM月dd日 HH:mm")
            </div>
        </div>

        <a asp-controller="ProjectPlan"
           asp-action="Create"
           class="btn btn-primary">
            ＋ 新建项目计划
        </a>

    </div>
</div>


<!-- 统计卡片 -->
<div class="row mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">总项目数</div>
                    <h4 class="mb-0">0</h4>
                </div>
                <div style="font-size:28px">📁</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">一级节点</div>
                    <h4 class="mb-0">0</h4>
                </div>
                <div style="font-size:28px">🔵</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">二级节点</div>
                    <h4 class="mb-0">0</h4>
                </div>
                <div style="font-size:28px">🟢</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">三级节点</div>
                    <h4 class="mb-0">0</h4>
                </div>
                <div style="font-size:28px">🟣</div>
            </div>
        </div>
    </div>

</div>


<!-- 快捷功能 -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h6 class="mb-0">快捷功能</h6>
    </div>

    <div class="card-body">
        <div class="row text-center">

            <div class="col-md-2">
                <a asp-controller="ProjectPlan" asp-action="Index"
                   class="text-decoration-none text-dark">
                    <div class="p-3 border rounded">
                        <div style="font-size:26px">📊</div>
                        <div class="mt-1">项目计划</div>
                    </div>
                </a>
            </div>

            <div class="col-md-2">
                <a asp-controller="ProjectPlan" asp-action="Create"
                   class="text-decoration-none text-dark">
                    <div class="p-3 border rounded">
                        <div style="font-size:26px">➕</div>
                        <div class="mt-1">新建计划</div>
                    </div>
                </a>
            </div>

            <div class="col-md-2">
                <a asp-controller="Account" asp-action="Profile"
                   class="text-decoration-none text-dark">
                    <div class="p-3 border rounded">
                        <div style="font-size:26px">👤</div>
                        <div class="mt-1">个人资料</div>
                    </div>
                </a>
            </div>

            <div class="col-md-2">
                <a asp-controller="Account" asp-action="ChangePassword"
                   class="text-decoration-none text-dark">
                    <div class="p-3 border rounded">
                        <div style="font-size:26px">🔒</div>
                        <div class="mt-1">修改密码</div>
                    </div>
                </a>
            </div>

            <div class="col-md-2">
                <a asp-controller="ProjectPlan" asp-action="Index"
                   class="text-decoration-none text-dark">
                    <div class="p-3 border rounded">
                        <div style="font-size:26px">🧩</div>
                        <div class="mt-1">节点管理</div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</div>


<!-- 最近项目 -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h6 class="mb-0">最近项目</h6>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>项目名称</th>
                    <th>负责人</th>
                    <th>节点进度</th>
                    <th>状态</th>
                    <th width="120">操作</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td colspan="5"
                        class="text-center text-muted py-4">
                        暂无项目数据，点击右上角「新建项目计划」
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>