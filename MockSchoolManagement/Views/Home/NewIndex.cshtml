@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager
@{
    ViewBag.Title = "首页 - 项目计划管理系统";
    var appUser = await _userManager.GetUserAsync(User);
}
@section Style{
    <link href="~/css/NewIndex/site.css" rel="stylesheet"/>
}

<!-- 首页顶部欢迎区 -->
<div class="welcome-box mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="font-weight-bold mb-1">👋 欢迎回来，@appUser.Name</h3>
            <p class="text-muted mb-0">今天是 @DateTime.Now.ToString("yyyy年MM月dd日 HH:mm")，高效管理你的项目节点</p>
        </div>
        <a asp-controller="ProjectPlan" asp-action="Create" class="btn btn-primary">
            + 新建项目计划
        </a>
    </div>
</div>

<!-- 数据统计卡片 -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon">📋</div>
            <div class="stat-info">
                <h4>0</h4>
                <span>总项目数</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-green">
            <div class="stat-icon">🔵</div>
            <div class="stat-info">
                <h4>0</h4>
                <span>一级节点</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-orange">
            <div class="stat-icon">🟢</div>
            <div class="stat-info">
                <h4>0</h4>
                <span>二级节点</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-purple">
            <div class="stat-icon">🟣</div>
            <div class="stat-info">
                <h4>0</h4>
                <span>三级节点</span>
            </div>
        </div>
    </div>
</div>

<!-- 快捷功能区 -->
<div class="section-title mb-3">
    <h5 class="font-weight-bold">快捷功能</h5>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <a asp-controller="ProjectPlan" asp-action="Index" class="func-card">
            <div class="func-icon">📊</div>
            <div class="func-text">项目计划</div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-controller="Student" asp-action="Index" class="func-card">
            <div class="func-icon">👨‍🎓</div>
            <div class="func-text">学生管理</div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-controller="Course" asp-action="Index" class="func-card">
            <div class="func-icon">📚</div>
            <div class="func-text">课程管理</div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-controller="Teacher" asp-action="Index" class="func-card">
            <div class="func-icon">👨‍🏫</div>
            <div class="func-text">教师管理</div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-controller="Departments" asp-action="Index" class="func-card">
            <div class="func-icon">🏢</div>
            <div class="func-text">学院管理</div>
        </a>
    </div>
    <div class="col-md-2">
        <a asp-controller="ProjectPlan" asp-action="Index" class="func-card">
            <div class="func-icon">✅</div>
            <div class="func-text">节点管理</div>
        </a>
    </div>
</div>

<!-- 最近项目列表 -->
<div class="section-title mb-3">
    <h5 class="font-weight-bold">最近项目</h5>
</div>
<div class="table-card">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>项目名称</th>
                <th>负责人</th>
                <th>节点进度</th>
                <th>状态</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    暂无项目数据，点击右上角「新建项目计划」开始
                </td>
            </tr>
        </tbody>
    </table>
</div>
