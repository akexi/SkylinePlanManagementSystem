@using MockSchoolManagement.Application.Dtos;
@model PaginationModel
@{
    ViewBag.Title = "学生列表页面";
}
<h1>学生列表</h1>
<form asp-action="Index" method="get">
    <div class="form-actions no-color mb-3">
        <div class="d-flex flex-wrap align-items-center">
            <span class="mr-2">请输入名称：</span>
            <input type="text"
                   name="searchString"
                   value="@ViewBag.CurrentFilter"
                   class="form-control mr-2"
                   style="max-width: 260px;" />
            <button type="submit" class="btn btn-outline-dark mr-2">查询</button>
            <a asp-action="Index" class="btn btn-light mr-2">返回所有列表</a>
            <a asp-action="Create" class="btn btn-primary">添加学生</a>
        </div>
    </div>
</form>

<div class="row">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th scope="col">头像</th>
                <th scope="col" class="sort-link">
                    <a asp-action="Index" asp-route-sortby="Name"> 名字 </a>
                    <a class="pl-3" asp-action="Index" asp-route-sortby="Name desc"> 降序 </a>
                </th>
                <th scope="col">
                    <a asp-action="Index" asp-route-sortby="Email"> 邮箱地址 </a>
                    <a class="pl-3" asp-action="Index" asp-route-sortby="Email desc"> 降序 </a>
                </th>
                <th scope="col">
                    <a asp-action="Index" asp-route-sortby="Major"> 主修科目 </a>
                    <a class="pl-3" asp-action="Index" asp-route-sortby="Major desc"> 降序 </a>
                </th>
                <th scope="col">
                    <a asp-action="Index" asp-route-sortby="EnrollmentDate"> 入学时间 </a>
                    <a class="pl-3" asp-action="Index" asp-route-sortby="EnrollmentDate desc"> 降序 </a>
                </th>
                <th scope="col">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var student in Model.Data)
            {
                var photoPath = "~/images/noimage.png";

                if (!string.IsNullOrEmpty(student.PhotoPath) && student.PhotoPath != "noimage.png")
                {
                    photoPath = "~/images/avatars/" + student.PhotoPath;
                }
                <tr>
                    <td>
                        <img class="table-img imageThumbnail" src="@photoPath" asp-append-version="true" />
                    </td>
                    <td scope="row">@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Major.GetDisplayName()</td>
                    <td>@student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <form method="post" asp-action="DeleteUser" asp-route-id="@student.Id">
                            <a asp-controller="Home" class="btn btn-info" asp-action="Details" asp-route-id="@student.EncryptedId">查看</a>
                            <a asp-controller="Home" asp-action="Edit" asp-route-id="@student.EncryptedId" class="btn btn-primary m-1">编辑</a>
                            <span id="confirmDeleteSpan_@student.Id" style="display:none">
                                <span>您确定要删除吗？</span>
                                <button type="submit" class="btn btn-danger">是</button>
                                <a href="#" class="btn btn-primary" onclick="confirmDelete('@student.Id', false)"> 否 </a>
                            </span>
                            <span id="deleteSpan_@student.Id">
                                <a href="#" class="btn btn-danger" onclick="confirmDelete('@student.Id', true)">删除</a>
                            </span>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <ul class="pagination">
            <li class="page-item @(!Model.ShowFirst ? "disabled" : "")">
                <a asp-action="Index"
                   asp-route-currentPage="1"
                   asp-route-searchString="@ViewBag.CurrentFilter"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="page-link"
                   aria-label="首页">首页</a>
            </li>

            <li class="page-item @(!Model.ShowPrevious ? "disabled" : "")">
                <a asp-action="Index"
                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="page-link"
                   aria-label="上一页">上一页</a>
            </li>

            <li class="page-item disabled">
                <a class="page-link">
                    @Model.CurrentPage
                </a>
            </li>

            <li class="page-item @(!Model.ShowNext ? "disabled" : "")">
                <a asp-action="Index"
                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="page-link"
                   aria-label="下一页">下一页</a>
            </li>

            <li class="page-item @(!Model.ShowLast ? "disabled" : "")">
                <a asp-action="Index"
                   asp-route-currentPage="@Model.TotalPages"
                   asp-route-searchString="@ViewBag.CurrentFilter"
                   asp-route-sortBy="@ViewBag.SortBy"
                   class="page-link"
                   aria-label="末页">末页</a>
            </li>
        </ul>
    </div>

</div>

@section Scripts{
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
}
