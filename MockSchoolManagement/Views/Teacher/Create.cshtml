@using MockSchoolManagement.ViewModels.Teachers
@model TeacherCreateViewModel
@{
    ViewBag.Title = "创建教师信息";
}

<form asp-action="Create" method="post" class="">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="请输入教师姓名" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="HireDate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="HireDate" class="form-control" placeholder="请输入聘用日期" />
            <span asp-validation-for="HireDate" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="OfficeLocation.Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="OfficeLocation.Location" class="form-control" placeholder="请输入办公地点" />
            <span asp-validation-for="OfficeLocation.Location" class="text-danger"></span>
        </div>
    </div>


</form>
