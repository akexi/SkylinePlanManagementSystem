@{
    ViewBag.Title = "修改课程学分";
}

<h2>修改课程学分</h2>

@if(ViewBag.RowsAffected == null)
{
    <form asp-action="UpdateCourseCredits">

        <div class="form-group row">
            <label for="multiplier" class="col-sm-4 col-form-label">
                请输入一个数字，每门课程将乘以这个系数：
            </label>
            <div class="col-sm-8">
                <input type="text" id="multiplier" name="multiplier" class="form-control" placeholder="请输入学分" />
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-10">
                <button type="submit" class="btn btn-primary">创建</button>
            </div>
        </div>

    </form>
}

@if(ViewBag.RowsAffected != null)
{
    <p>已成功修改 @ViewBag.RowsAffected 门课程的学分。</p>
}

<div class="form-group">
    <a asp-action="Index" class="btn btn-info">返回</a>
</div>
