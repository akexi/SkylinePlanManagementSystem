<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/lib/twitter-bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/_Layoutsite.css" rel="stylesheet" />
    @RenderSection("Style", required: false)
    <title>@ViewBag.Title</title>
</head>

<body>

    @inject SignInManager<ApplicationUser> _signInManager

    <nav class="navbar navbar-expand-sm navbar-light bg-white">
        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center"
               asp-controller="home"
               asp-action="NewIndex">
                <img src="~/images/horon.png" width="120" />
                <span class="ml-2 font-weight-bold">
                    项目计划管理系统
                </span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-toggle="collapse"
                    data-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="collapsibleNavbar">

                <!-- 左侧菜单 -->
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="ProjectPlan"
                           asp-action="Index">
                            项目计划
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            学生管理
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Course"
                           asp-action="Index">
                            课程管理
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Teacher"
                           asp-action="Index">
                            教师管理
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Departments"
                           asp-action="Index">
                            学院管理
                        </a>
                    </li>

                    <!-- 系统管理菜单：仅管理员可见 -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                                系统管理
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Admin" asp-action="ListUsers">
                                    用户管理
                                </a>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="ListRoles">
                                    角色管理
                                </a>
                            </div>
                        </li>
                    }

                </ul>

                <!-- 右侧用户 -->
                <ul class="navbar-nav ml-auto">

                    @if (_signInManager.IsSignedIn(User))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-toggle="dropdown">

                                👤 @User.Identity.Name
                            </a>

                            <div class="dropdown-menu dropdown-menu-right">
                                <!-- 保留修改密码功能 -->
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="ChangePassword">
                                    修改密码
                                </a>

                                <div class="dropdown-divider"></div>

                                <form method="post"
                                      asp-controller="account"
                                      asp-action="logout">

                                    <button type="submit"
                                            class="dropdown-item">
                                        退出登录
                                    </button>

                                </form>

                            </div>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="account"
                               asp-action="login">
                                登录
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>


    <!-- 主体内容 -->
    <div class="container-fluid main-container">
        <div class="content-card">
            @RenderBody()
        </div>
    </div>



    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/jquery-validate/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>