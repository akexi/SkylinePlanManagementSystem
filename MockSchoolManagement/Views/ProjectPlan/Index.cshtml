@using SkylinePlanManagementSystem.Application.Dtos;
@model PagedResultDto<Project>
@{
    ViewBag.Title = "项目列表";
}
<h1>项目列表</h1>
<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
        <input type="hidden" name="Sorting" value="@Model.Sorting" />
        <p>
            请输入名称：
            <input type="text" name="FilterText" value="@Model.FilterText" />
            <input type="submit" value="查询" class="btn btn-outline-dark" />
            <a asp-action="Index">返回所有列表</a>|
            <a asp-action="Create">添加项目</a>
        </p>
    </div>
</form>

<div class="table-responsive-sm">
    @if (Model.Data.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th scope="col">项目ID</th>
                    <th scope="col" class="sort-link">
                        <a asp-action="Index"
                           asp-route-Sorting="ProjectName"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText">
                            项目名称
                        </a>
                        <a class="pl-3"
                           asp-action="Index"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText"
                           asp-route-Sorting="ProjectName desc">
                            降序
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                           asp-route-Sorting="Remark"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText">
                            备注
                        </a>
                        <a class="pl-3"
                           asp-action="Index"
                           asp-route-Sorting="Remark desc"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText">
                            降序
                        </a>
                    </th>
                    <th scope="col">
                        <a asp-action="Index"
                           asp-route-Sorting="Status"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText">
                            状态
                        </a>
                        <a class="pl-3"
                           asp-action="Index"
                           asp-route-Sorting="Status desc"
                           asp-route-CurrentPage="@Model.CurrentPage"
                           asp-route-FilterText="@Model.FilterText">
                            降序
                        </a>
                    </th>
                    <th scope="col">操作</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var project in Model.Data)
                {
                    <tr>
                        <td>@project.ProjectId</td>
                        <td>@project.ProjectName</td>
                        <td>@project.Remark</td>
                        <td scope="row">@project.Status</td>
                        <td class="text-muted">待实现</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">当前没有项目数据。</div>
    }
</div>

<div>
    <ul class="pagination">
        <li class="page-item @(!Model.ShowFirst ? "disabled" : "")">
            <a asp-route-CurrentPage="1"
               asp-route-FilterText="@Model.FilterText"
               asp-route-Sorting="@Model.Sorting"
               class="page-link">
                首页
            </a>
        </li>

        <li class="page-item @(!Model.ShowPrevious ? "disabled" : "")">
            <a asp-route-CurrentPage="@(Model.CurrentPage - 1)"
               asp-route-FilterText="@Model.FilterText"
               asp-route-Sorting="@Model.Sorting"
               class="page-link">
                上一页
            </a>
        </li>

        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a asp-route-CurrentPage="@i"
                   asp-route-FilterText="@Model.FilterText"
                   asp-route-Sorting="@Model.Sorting"
                   class="page-link">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(!Model.ShowNext ? "disabled" : "")">
            <a asp-route-CurrentPage="@(Model.CurrentPage + 1)"
               asp-route-FilterText="@Model.FilterText"
               asp-route-Sorting="@Model.Sorting"
               class="page-link">
                下一页
            </a>
        </li>

        <li class="page-item @(!Model.ShowLast ? "disabled" : "")">
            <a asp-route-CurrentPage="@Model.TotalPages"
               asp-route-FilterText="@Model.FilterText"
               asp-route-Sorting="@Model.Sorting"
               class="page-link">
                末页
            </a>
        </li>
    </ul>
</div>

@section Scripts {
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
}
