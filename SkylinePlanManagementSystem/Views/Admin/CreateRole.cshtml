@using SkylinePlanManagementSystem.ViewModels.Admin
@model CreateRoleViewModel
@{
    ViewBag.Title = "创建角色";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">创建角色</h2>
        <a asp-action="ListRoles" class="btn btn-outline-secondary">
            返回列表
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <form asp-action="CreateRole" method="post">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RoleName" class="form-label"></label>
                            <input asp-for="RoleName"
                                   class="form-control"
                                   placeholder="请输入角色名称" />
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="card-footer text-end">
                        <button type="submit" class="btn btn-primary me-2">
                            创建
                        </button>
                        <a asp-action="ListRoles" class="btn btn-outline-secondary">
                            取消
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

</div>