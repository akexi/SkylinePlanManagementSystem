@using SkylinePlanManagementSystem.ViewModels.Admin
@model EditUserViewModel
@{
    ViewBag.Title = "管理-编辑用户";
}

<div class="container-fluid px-0">

    <!-- 标题栏 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">编辑用户</h2>
        <a asp-action="ListUsers" class="btn btn-outline-secondary">
            ← 返回用户列表
        </a>
    </div>

    <form method="post">

        <div class="row">

            <!-- 左侧：基本信息 -->
            <div class="col-md-7">

                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        基本信息
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label asp-for="Id" class="form-label"></label>
                            <input asp-for="Id" disabled class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label"></label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DepartmentId" class="form-label"></label>
                            <select asp-for="DepartmentId"
                                    asp-items="Model.DepartmentList"
                                    class="form-select">
                                <option value="">-- 请选择所属部门 --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mt-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                    </div>
                </div>

            </div>


            <!-- 右侧：权限信息 -->
            <div class="col-md-5">

                <!-- 用户角色 -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-success text-white">
                        用户角色
                    </div>

                    <div class="card-body">

                        @if (Model.Roles.Any())
                        {
                            foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-success me-2 mb-2">
                                    @role
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">该用户目前还没有角色</span>
                        }

                    </div>

                    <div class="card-footer text-end">
                        <a asp-controller="Admin"
                           asp-action="ManageUserRoles"
                           asp-route-userId="@Model.Id"
                           class="btn btn-sm btn-success">
                            管理角色
                        </a>
                    </div>
                </div>


                <!-- 用户声明 -->
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        用户声明
                    </div>

                    <div class="card-body">

                        @if (Model.Claims.Any())
                        {
                            foreach (var claim in Model.Claims)
                            {
                                <div class="border rounded p-2 mb-2 bg-light">
                                    <strong>@claim.Type</strong>
                                    <div class="text-muted small">
                                        @claim.Value
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">目前没有声明</span>
                        }

                    </div>

                    <div class="card-footer text-end">
                        <a asp-controller="Admin"
                           asp-action="ManageUserClaims"
                           asp-route-userId="@Model.Id"
                           class="btn btn-sm btn-info text-white">
                            管理声明
                        </a>
                    </div>
                </div>

            </div>

        </div>


        <!-- 底部按钮 -->
        <div class="card mt-3 shadow-sm">
            <div class="card-body text-end">

                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                <button type="submit" class="btn btn-primary me-2">
                    保存修改
                </button>

                <a asp-action="ListUsers" class="btn btn-outline-secondary">
                    取消
                </a>

            </div>
        </div>

    </form>

</div>