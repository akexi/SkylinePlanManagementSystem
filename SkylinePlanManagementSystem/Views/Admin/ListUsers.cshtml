@model IEnumerable<ApplicationUser>
@{
    ViewBag.Title = "用户管理";
}

<div class="card shadow-sm">

    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">用户管理</h5>

        <a asp-controller="Account"
           asp-action="Register"
           class="btn btn-primary btn-sm">
            创建用户
        </a>
    </div>

    <div class="card-body p-0">

        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>用户名</th>
                        <th>姓名</th>
                        <th>邮箱</th>
                        <th>手机号</th>
                        <th>部门</th>
                        <th width="150">操作</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.DepartmentId</td>

                            <td>
                                <form method="post"
                                      asp-controller="Admin"
                                      asp-action="DeleteUser"
                                      asp-route-id="@user.Id"
                                      class="d-inline">

                                    <a asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        编辑
                                    </a>

                                    <span id="confirmDeleteSpan_@user.Id"
                                          style="display:none">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            确认
                                        </button>

                                        <a href="#"
                                           class="btn btn-sm btn-secondary"
                                           onclick="confirmDelete('@user.Id',false)">
                                            取消
                                        </a>
                                    </span>

                                    <span id="deleteSpan_@user.Id">
                                        <a href="#"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="confirmDelete('@user.Id',true)">
                                            删除
                                        </a>
                                    </span>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                暂无用户
                <div class="mt-2">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary btn-sm">
                        创建用户
                    </a>
                </div>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
}