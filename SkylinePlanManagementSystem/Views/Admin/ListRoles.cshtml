@model IEnumerable<IdentityRole>
@{
    ViewBag.Title = "角色列表";
}

<div class="container-fluid px-0">

    <!-- 标题栏 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <svg class="icon" aria-hidden="true">
                <use xlink:href="#icon-jiaoseguanli"></use>
            </svg>
            角色管理
        </h2>

        <a class="btn btn-primary"
           asp-action="CreateRole">
            + 新建角色
        </a>
    </div>


    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                系统角色列表
            </div>

            <div class="card-body p-0">

                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 35%">角色名称</th>
                            <th style="width: 45%">角色ID</th>
                            <th style="width: 20%" class="text-end">操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        @role.Name
                                    </span>
                                </td>

                                <td class="text-muted small">
                                    @role.Id
                                </td>

                                <td class="text-end">

                                    <form asp-controller="Admin"
                                          asp-action="DeleteRole"
                                          asp-route-id="@role.Id"
                                          method="post"
                                          class="d-inline">

                                        @if ((await authorizationService.AuthorizeAsync(User, "EditRolePolicy")).Succeeded)
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="EditRole"
                                               asp-route-id="@role.Id"
                                               class="btn btn-sm btn-outline-primary me-2">
                                                编辑
                                            </a>
                                        }

                                        <span id="confirmDeleteSpan_@role.Id" style="display:none">
                                            <span class="me-2 text-danger">确认删除？</span>

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger me-1">
                                                是
                                            </button>

                                            <a href="#"
                                               class="btn btn-sm btn-secondary"
                                               onclick="confirmDelete('@role.Id',false)">
                                                否
                                            </a>
                                        </span>

                                        <span id="deleteSpan_@role.Id">
                                            <a href="#"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="confirmDelete('@role.Id',true)">
                                                <svg class="icon" aria-hidden="true">
                                                    <use xlink:href="#icon-shanchu"></use>
                                                </svg>
                                                删除
                                            </a>
                                        </span>

                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">

                <h5 class="text-muted mb-3">
                    还没有创建任何角色
                </h5>

                <a class="btn btn-primary"
                   asp-controller="Admin"
                   asp-action="CreateRole">
                    创建第一个角色
                </a>

            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
}