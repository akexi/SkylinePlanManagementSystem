@model SkylinePlanManagementSystem.ViewModels.ProjectPlan.ProjectCreateViewModel
@{
    ViewBag.Title = "项目视图";
    var nodes = ViewBag.ProjectNodes as List<ProjectNode> ?? new List<ProjectNode>();

    int? currentUserDepartmentId = ViewBag.CurrentUserDepartmentId as int?;

    string currentUserDepartmentName = ViewBag.CurrentUserDepartmentName as string ?? "未绑定部门";

    var departmentNodes = currentUserDepartmentId.HasValue
        ? nodes.Where(n => n.DepartmentId == currentUserDepartmentId.Value).OrderBy(n => n.ProjectNodeId).ToList()
        : new List<ProjectNode>();

    var otherDepartmentNodes = currentUserDepartmentId.HasValue
        ? nodes.Where(n => n.DepartmentId != currentUserDepartmentId.Value).OrderBy(n => n.ProjectNodeId).ToList()
        : nodes.OrderBy(n => n.ProjectNodeId).ToList();

    var activeTab = ViewBag.ActiveTab as string ?? "all-nodes";
}

<div class="project-detail-page">
    <div class="project-detail-header">
        <div>
            <h3 class="mb-1">@Model.ProjectName</h3>
            <p class="text-muted mb-0">项目ID：@Model.ProjectId</p>
        </div>
        <div class="project-detail-actions">
            <a asp-action="Index" class="btn btn-outline-secondary ml-2">返回项目列表</a>
        </div>
    </div>

    <div class="project-info-card mt-3">
        <div class="row">
            <div class="col-md-3"><strong>状态：</strong><span class="badge badge-info ml-1">@Model.Status</span></div>
            <div class="col-md-3"><strong>开始时间：</strong>@(Model.StartTime?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div class="col-md-3"><strong>结束时间：</strong>@(Model.EndTime?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div class="col-md-3"><strong>备注：</strong>@(string.IsNullOrWhiteSpace(Model.Remark) ? "-" : Model.Remark)</div>
        </div>
    </div>

    <div class="node-panel mt-4">
        <h5 class="mb-3">项目一级节点管理</h5>

        @if (TempData["ProjectNodeError"] != null)
        {
            <div class="alert alert-danger">@TempData["ProjectNodeError"]</div>
        }
        <div class="alert alert-secondary">
            当前用户部门：<strong>@currentUserDepartmentName</strong>。
            @if (!currentUserDepartmentId.HasValue)
            {
                <span class="text-danger">未绑定部门时不可新增、修改、删除节点。</span>
            }
        </div>

        @if (nodes.Any())
        {
            <ul class="nav nav-tabs mb-3" id="projectNodeTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "all-nodes" ? "active" : "")" id="all-nodes-tab" href="@Url.Action("Project", "ProjectPlan", new { id = Model.ProjectId, tab = "all-nodes" })" role="tab">全部节点（@nodes.Count）</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "current-dept" ? "active" : "")" id="current-dept-tab" href="@Url.Action("Project", "ProjectPlan", new { id = Model.ProjectId, tab = "current-dept" })" role="tab">当前部门节点（@departmentNodes.Count）</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "other-dept" ? "active" : "")" id="other-dept-tab" href="@Url.Action("Project", "ProjectPlan", new { id = Model.ProjectId, tab = "other-dept" })" role="tab">其他部门节点（@otherDepartmentNodes.Count）</a>
                </li>
                <li class="nav-item ml-2 align-self-center">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addNodeModal" @(currentUserDepartmentId.HasValue ? null : "disabled")>+ 新增节点</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade @(activeTab == "all-nodes" ? "show active" : "")" id="all-nodes" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 全部</div>
                        <div class="card-body p-0">
                            <div class="table-responsive project-table-wrap">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">ID</th>
                                            <th style="width:160px;">所属部门</th>
                                            <th>节点名称</th>
                                            <th style="width:200px;">计划开始/完成</th>
                                            <th style="width:280px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var node in nodes.OrderBy(n => n.ProjectNodeId))
                                        {
                                            <tr>
                                                <form asp-action="UpdateNode" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                    <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                    <td>@node.ProjectNodeId</td>
                                                    <td>@(node.Department?.Name ?? "未归属")</td>
                                                    <td>
                                                        <span class="view-mode">@node.Title</span>
                                                        <input type="text" name="Title" value="@node.Title" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td>
                                                        <span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanStartTime" value="@(node.PlanStartTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                        <span class="view-mode"> / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanEndTime" value="@(node.PlanEndTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                <td class="node-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-edit" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>编辑</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary d-none btn-save" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>保存</button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                        <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-all-@node.ProjectNodeId">子节点管理@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                        <button type="submit" formaction="@Url.Action("DeleteNode", "ProjectPlan")" name="projectNodeId" value="@node.ProjectNodeId" class="btn btn-sm btn-outline-danger" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled") onclick="return confirm('确定删除节点【@node.Title】吗？');">删除</button>
                                                    </td>
                                                </form>
                                            </tr>
                                            <tr id="subnode-all-@node.ProjectNodeId" class="subnode-row d-none">
                                                <td colspan="5" class="bg-light">
                                                    <div class="subnode-box p-3">
                                                        <form asp-action="AddSubNode" method="post" class="form-row mb-2 subnode-add-form">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                            <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                            <div class="col-md-3"><input type="text" name="Title" class="form-control form-control-sm" placeholder="新增子节点名称" required /></div>
                                                            <div class="col-md-3"><input type="text" name="Detail" class="form-control form-control-sm" placeholder="子节点明细（可选）" /></div>
                                                            <div class="col-md-2"><select name="ProgressStatus" class="custom-select custom-select-sm"><option>未开始</option><option>进行中</option><option>已完成</option><option>已延期</option></select></div>
                                                            <div class="col-md-2"><input type="date" name="PlanStartTime" class="form-control form-control-sm" /></div>
                                                            <div class="col-md-2"><input type="date" name="PlanEndTime" class="form-control form-control-sm" /></div>
                                                            <div class="col-md-12 mt-2"><button type="submit" class="btn btn-sm btn-primary" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>+ 新增子节点</button></div>
                                                        </form>
                                                        @if (node.SubNodes != null && node.SubNodes.Any())
                                                        {
                                                            <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                <thead><tr><th style="width:60px;">ID</th><th>子节点名称</th><th>子节点明细</th><th style="width:180px;">计划开始/完成</th><th style="width:120px;">状态</th><th style="width:200px;">操作</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                    {
                                                                        <tr class="subnode-item-row">
                                                                            <form asp-action="UpdateSubNode" method="post" class="subnode-edit-form">
                                                                                @Html.AntiForgeryToken()
                                                                                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                                <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                                <input type="hidden" name="ProjectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                            <td>@subNode.ProjectSubNodeId</td>
                                                                            <td>
                                                                                <span class="view-mode">@subNode.Title</span>
                                                                                <input type="text" name="Title" value="@subNode.Title" class="form-control form-control-sm edit-mode d-none" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</span>
                                                                                <input type="text" name="Detail" value="@subNode.Detail" class="form-control form-control-sm edit-mode d-none" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                <input type="date" name="PlanStartTime" value="@(subNode.PlanStartTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                                                <span class="view-mode"> / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                <input type="date" name="PlanEndTime" value="@(subNode.PlanEndTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@subNode.ProgressStatus</span>
                                                                                <select name="ProgressStatus" class="custom-select custom-select-sm edit-mode d-none">
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "未开始")">未开始</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "进行中")">进行中</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "已完成")">已完成</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "已延期")">已延期</option>
                                                                                </select>
                                                                            </td>
                                                                            <td>
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-edit" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled")>编辑</button>
                                                                                <button type="submit" class="btn btn-sm btn-outline-primary d-none btn-save" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled")>保存</button>
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                                                <button type="submit" formaction="@Url.Action("DeleteSubNode", "ProjectPlan")" name="projectSubNodeId" value="@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-danger" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled") onclick="return confirm('确定删除子节点【@subNode.Title】吗？');">删除</button>
                                                                            </td>
                                                                            </form>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "current-dept" ? "show active" : "")" id="current-dept" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 当前部门</div>
                        <div class="card-body p-0">
                            @if (departmentNodes.Any())
                            {
                                <div class="table-responsive project-table-wrap">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:60px;">ID</th>
                                                <th style="width:160px;">所属部门</th>
                                                <th>节点名称</th>
                                                <th style="width:200px;">计划开始/完成</th>
                                                <th style="width:280px;">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var node in departmentNodes)
                                            {
                                                <tr>
                                                    <form asp-action="UpdateNode" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                        <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                    <td>@node.ProjectNodeId</td>
                                                    <td>@(node.Department?.Name ?? "未归属")</td>
                                                    <td>
                                                        <span class="view-mode">@node.Title</span>
                                                        <input type="text" name="Title" value="@node.Title" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td>
                                                        <span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanStartTime" value="@(node.PlanStartTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                        <span class="view-mode"> / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanEndTime" value="@(node.PlanEndTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td class="node-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-edit">编辑</button>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary d-none btn-save">保存</button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                        <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-current-@node.ProjectNodeId">子节点管理@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                        <button type="submit" formaction="@Url.Action("DeleteNode", "ProjectPlan")" name="projectNodeId" value="@node.ProjectNodeId" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除节点【@node.Title】吗？');">删除</button>
                                                    </td>
                                                    </form>
                                                </tr>
                                                <tr id="subnode-current-@node.ProjectNodeId" class="subnode-row d-none">
                                                    <td colspan="5" class="bg-light">
                                                        <div class="subnode-box p-3">
                                                            <form asp-action="AddSubNode" method="post" class="form-row mb-2 subnode-add-form">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                <div class="col-md-3"><input type="text" name="Title" class="form-control form-control-sm" placeholder="新增子节点名称" required /></div>
                                                                <div class="col-md-3"><input type="text" name="Detail" class="form-control form-control-sm" placeholder="子节点明细（可选）" /></div>
                                                                <div class="col-md-2"><select name="ProgressStatus" class="custom-select custom-select-sm"><option>未开始</option><option>进行中</option><option>已完成</option><option>已延期</option></select></div>
                                                                <div class="col-md-2"><input type="date" name="PlanStartTime" class="form-control form-control-sm" /></div>
                                                                <div class="col-md-2"><input type="date" name="PlanEndTime" class="form-control form-control-sm" /></div>
                                                                <div class="col-md-12 mt-2"><button type="submit" class="btn btn-sm btn-primary">+ 新增子节点</button></div>
                                                            </form>
                                                            @if (node.SubNodes != null && node.SubNodes.Any())
                                                            {
                                                                <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                    <thead><tr><th style="width:60px;">ID</th><th>子节点名称</th><th>子节点明细</th><th style="width:180px;">计划开始/完成</th><th style="width:120px;">状态</th><th style="width:200px;">操作</th></tr></thead>
                                                                    <tbody>
                                                                        @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                        {
                                                                            <tr class="subnode-item-row">
                                                                                <form asp-action="UpdateSubNode" method="post" class="subnode-edit-form">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                                    <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                                    <input type="hidden" name="ProjectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                                <td>@subNode.ProjectSubNodeId</td>
                                                                                <td>
                                                                                    <span class="view-mode">@subNode.Title</span>
                                                                                    <input type="text" name="Title" value="@subNode.Title" class="form-control form-control-sm edit-mode d-none" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</span>
                                                                                    <input type="text" name="Detail" value="@subNode.Detail" class="form-control form-control-sm edit-mode d-none" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                    <input type="date" name="PlanStartTime" value="@(subNode.PlanStartTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                                                    <span class="view-mode"> / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                    <input type="date" name="PlanEndTime" value="@(subNode.PlanEndTime?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm edit-mode d-none" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@subNode.ProgressStatus</span>
                                                                                    <select name="ProgressStatus" class="custom-select custom-select-sm edit-mode d-none">
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "未开始")">未开始</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "进行中")">进行中</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "已完成")">已完成</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "已延期")">已延期</option>
                                                                                    </select>
                                                                                </td>
                                                                                <td>
                                                                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-edit">编辑</button>
                                                                                    <button type="submit" class="btn btn-sm btn-outline-primary d-none btn-save">保存</button>
                                                                                    <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                                                    <button type="submit" formaction="@Url.Action("DeleteSubNode", "ProjectPlan")" name="projectSubNodeId" value="@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除子节点【@subNode.Title】吗？');">删除</button>
                                                                                </td>
                                                                                </form>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-muted">当前部门暂无一级节点。</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "other-dept" ? "show active" : "")" id="other-dept" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 其他部门</div>
                        <div class="card-body p-0">
                            @if (otherDepartmentNodes.Any())
                            {
                                <div class="table-responsive project-table-wrap">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:60px;">ID</th>
                                                <th style="width:160px;">所属部门</th>
                                                <th>节点名称</th>
                                                <th style="width:200px;">计划开始/完成</th>
                                                <th style="width:280px;">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var node in otherDepartmentNodes)
                                            {
                                                <tr>
                                                    <form asp-action="UpdateNode" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                        <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                    <td>@node.ProjectNodeId</td>
                                                    <td>@(node.Department?.Name ?? "未归属")</td>
                                                    <td><span class="view-mode">@node.Title</span></td>
                                                    <td><span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-") / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                                                    <td class="node-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>编辑</button>
                                                        <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-other-@node.ProjectNodeId">子节点管理@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled>删除</button>
                                                    </td>
                                                    </form>
                                                </tr>
                                                <tr id="subnode-other-@node.ProjectNodeId" class="subnode-row d-none">
                                                    <td colspan="5" class="bg-light">
                                                        <div class="subnode-box p-3">
                                                            @if (node.SubNodes != null && node.SubNodes.Any())
                                                            {
                                                                <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                    <thead><tr><th style="width:60px;">ID</th><th>子节点名称</th><th>子节点明细</th><th style="width:180px;">计划开始/完成</th><th style="width:120px;">状态</th></tr></thead>
                                                                    <tbody>
                                                                        @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                        {
                                                                            <tr class="subnode-item-row">
                                                                                <td>@subNode.ProjectSubNodeId</td>
                                                                                <td>@subNode.Title</td>
                                                                                <td>@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</td>
                                                                                <td>@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-") / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                                                <td>@subNode.ProgressStatus</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-muted">暂无其他部门一级节点。</div>
                            }
                        </div>
                    </div>
                </div>


            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">当前项目暂无一级节点，可在上方新增。</div>
        }
    </div>
</div>

@section Style {
    <link href="~/css/project-plan-index.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/projectplan/Project.js"></script>
}

<div class="modal fade" id="addNodeModal" tabindex="-1" role="dialog" aria-labelledby="addNodeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="AddNode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addNodeModalLabel">新增一级节点</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>一级节点名称</label><input type="text" name="Title" class="form-control" required /></div>
                    <div class="form-row"><div class="col"><label>计划开始日期</label><input type="date" name="PlanStartTime" class="form-control" /></div><div class="col"><label>计划结束日期</label><input type="date" name="PlanEndTime" class="form-control" /></div></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">取消</button><button type="submit" class="btn btn-primary">保存节点</button></div>
            </form>
        </div>
    </div>
</div>
