@model SkylinePlanManagementSystem.ViewModels.ProjectPlan.ProjectCreateViewModel
@{
    ViewBag.Title = "项目视图";
    var nodes = ViewBag.ProjectNodes as List<ProjectNode> ?? new List<ProjectNode>();

    int? currentUserDepartmentId = ViewBag.CurrentUserDepartmentId as int?;

    string currentUserDepartmentName = ViewBag.CurrentUserDepartmentName as string ?? "未绑定部门";

    var departmentNodes = currentUserDepartmentId.HasValue
        ? nodes.Where(n => n.DepartmentId == currentUserDepartmentId.Value).OrderBy(n => n.ProjectNodeId).ToList()
        : new List<ProjectNode>();

    var otherDepartmentNodes = currentUserDepartmentId.HasValue
        ? nodes.Where(n => n.DepartmentId != currentUserDepartmentId.Value).OrderBy(n => n.ProjectNodeId).ToList()
        : nodes.OrderBy(n => n.ProjectNodeId).ToList();

    var activeTab = ViewBag.ActiveTab as string ?? "all-nodes";

    // Timeline Calculations for Gantt Chart
    var projectStart = Model.StartTime ?? (nodes.Any(n => n.PlanStartTime.HasValue) ? nodes.Where(n => n.PlanStartTime.HasValue).Min(n => n.PlanStartTime) : null) ?? DateTime.Now;
    var projectEnd = Model.EndTime ?? (nodes.Any(n => n.PlanEndTime.HasValue) ? nodes.Where(n => n.PlanEndTime.HasValue).Max(n => n.PlanEndTime) : null) ?? DateTime.Now.AddMonths(3);
    if (projectEnd <= projectStart)
    {
        projectEnd = projectStart.AddDays(30);
    }
    var totalProjectDays = (projectEnd - projectStart).TotalDays;
    if (totalProjectDays <= 0) totalProjectDays = 1;
}

<div class="project-detail-page">
    <div class="project-detail-header">
        <div>
            <h3 class="mb-1">@Model.ProjectName</h3>
            <p class="text-muted mb-0">项目ID：@Model.ProjectId</p>
        </div>
        <div class="project-detail-actions">
            <a asp-action="Index" class="btn btn-outline-secondary ml-2">返回项目列表</a>
        </div>
    </div>

    <div class="project-info-card mt-3">
        <div class="row align-items-center">
            <div class="col-md-2"><strong>状态：</strong><span class="badge badge-info ml-1">@Model.Status</span></div>
            <div class="col-md-2"><strong>开始时间：</strong>@(Model.StartTime?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div class="col-md-2"><strong>结束时间：</strong>@(Model.EndTime?.ToString("yyyy-MM-dd") ?? "-")</div>
            <div class="col-md-3"><strong>备注：</strong>@(string.IsNullOrWhiteSpace(Model.Remark) ? "-" : Model.Remark)</div>
            <div class="col-md-3">
                <strong>项目整体进度：</strong>
                <div class="progress mt-1" style="height:18px;">
                    <div id="project-overall-progress" class="progress-bar bg-primary" role="progressbar" style="width: @Model.CompletionProgress%;" aria-valuenow="@Model.CompletionProgress" aria-valuemin="0" aria-valuemax="100">@Model.CompletionProgress.ToString("0.##")%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 甘特时间线 / Gantt Timeline -->
    @if (nodes.Any(n => n.PlanStartTime.HasValue || n.PlanEndTime.HasValue))
    {
        <div class="project-info-card mt-3">
            <h5 class="mb-3 d-flex align-items-center">
                <span class="mr-2" style="width: 4px; height: 18px; background-color: #0d6efd; display: inline-block; border-radius: 2px;"></span>
                项目执行甘特时间线
            </h5>
            <div class="timeline-gantt-wrapper">
                <!-- Timeline Header (Months/Quarters/Dates) -->
                <div class="gantt-header d-flex justify-content-between text-muted small border-bottom pb-2 mb-2">
                    <span>@projectStart.ToString("yyyy-MM-dd")</span>
                    <span>@projectStart.AddDays(totalProjectDays / 2).ToString("yyyy-MM-dd")</span>
                    <span>@projectEnd.ToString("yyyy-MM-dd")</span>
                </div>

                <!-- Gantt Rows -->
                <div class="gantt-rows">
                    @foreach (var node in nodes.OrderBy(n => n.PlanStartTime ?? DateTime.MaxValue))
                    {
                        var nStart = node.PlanStartTime ?? projectStart;
                        var nEnd = node.PlanEndTime ?? projectEnd;
                        if (nStart < projectStart) { nStart = projectStart; }
                        if (nEnd > projectEnd) { nEnd = projectEnd; }
                        if (nEnd < nStart) { nEnd = nStart; }

                        var leftPercent = (nStart - projectStart).TotalDays / totalProjectDays * 100.0;
                        var widthPercent = (nEnd - nStart).TotalDays / totalProjectDays * 100.0;

                        // Bound the values between 0 and 100
                        if (leftPercent < 0) { leftPercent = 0; }
                        if (leftPercent > 100) { leftPercent = 100; }
                        if (widthPercent < 0) { widthPercent = 0; }
                        if (leftPercent + widthPercent > 100) { widthPercent = 100 - leftPercent; }
                        if (widthPercent < 3.0) { widthPercent = 3.0; } // Ensure visible minimum width

                        <div class="gantt-row py-2 border-bottom align-items-center">
                            <div class="row">
                                <div class="col-md-3 d-flex align-items-center justify-content-between mb-1 mb-md-0">
                                    <span class="font-weight-bold text-dark text-truncate" title="@node.Title">@node.Title</span>
                                    <span class="badge badge-light text-muted small">@(node.Department?.Name ?? "未归属")</span>
                                </div>
                                <div class="col-md-9 position-relative">
                                    <div class="gantt-bar-container bg-light rounded" style="height: 24px; width: 100%; position: relative; overflow: hidden;">
                                        <!-- Node Bar -->
                                        <div class="gantt-bar d-flex align-items-center justify-content-center text-white font-weight-bold small rounded"
                                             style="position: absolute; left: @(leftPercent.ToString("F2"))%; width: @(widthPercent.ToString("F2"))%; height: 100%; background: linear-gradient(90deg, #3b82f6, #1d4ed8); transition: all 0.3s ease; font-size: 11px;">
                                            <div class="gantt-bar-progress bg-success" style="position: absolute; left: 0; top: 0; bottom: 0; width: @(node.CompletionProgress)%; opacity: 0.85; z-index: 1;"></div>
                                            <span style="z-index: 2; text-shadow: 0 1px 2px rgba(0,0,0,0.4);">@node.CompletionProgress.ToString("0.##")%</span>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted xsmall mt-1 px-1" style="font-size: 10px;">
                                        <span>@(node.PlanStartTime?.ToString("MM-dd") ?? "-")</span>
                                        <span>@(node.PlanEndTime?.ToString("MM-dd") ?? "-")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="node-panel mt-4">
        <h5 class="mb-3">项目一级节点管理</h5>

        @if (TempData["ProjectNodeError"] != null)
        {
            <div class="alert alert-danger">@TempData["ProjectNodeError"]</div>
        }
        <div class="alert alert-secondary">
            当前用户部门：<strong>@currentUserDepartmentName</strong>。
            @if (!currentUserDepartmentId.HasValue)
            {
                <span class="text-danger">未绑定部门时不可新增、修改、删除节点。</span>
            }
        </div>

        @if (nodes.Any())
        {
            <ul class="nav nav-tabs mb-3" id="projectNodeTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "all-nodes" ? "active" : "")" id="all-nodes-tab" data-toggle="tab" href="#all-nodes" role="tab" aria-controls="all-nodes" aria-selected="@(activeTab == "all-nodes" ? "true" : "false")">全部节点（@nodes.Count）</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "current-dept" ? "active" : "")" id="current-dept-tab" data-toggle="tab" href="#current-dept" role="tab" aria-controls="current-dept" aria-selected="@(activeTab == "current-dept" ? "true" : "false")">当前部门节点（@departmentNodes.Count）</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "other-dept" ? "active" : "")" id="other-dept-tab" data-toggle="tab" href="#other-dept" role="tab" aria-controls="other-dept" aria-selected="@(activeTab == "other-dept" ? "true" : "false")">其他部门节点（@otherDepartmentNodes.Count）</a>
                </li>
                <li class="nav-item ml-2 align-self-center">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addNodeModal" @(currentUserDepartmentId.HasValue ? null : "disabled")>+ 新增节点</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade @(activeTab == "all-nodes" ? "show active" : "")" id="all-nodes" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 全部</div>
                        <div class="card-body p-0">
                            <div class="table-responsive project-table-wrap">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">ID</th>
                                            <th style="width:160px;">所属部门</th>
                                            <th style="width:200px;">节点名称</th>
                                            <th style="width:200px;">计划开始/完成</th>
                                            <th style="width:220px;">完成进度</th>
                                            <th style="width:180px;">备注</th>
                                            <th style="width:280px;">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var node in nodes.OrderBy(n => n.ProjectNodeId))
                                        {
                                            <tr>
                                                <td>
                                                    @node.ProjectNodeId
                                                    <form id="node-edit-form-@node.ProjectNodeId" asp-action="UpdateNode" method="post" class="node-edit-form" style="display:none;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                        <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                    </form>
                                                    <form id="node-delete-form-@node.ProjectNodeId" asp-action="DeleteNode" method="post" class="node-delete-form" style="display:none;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                        <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                    </form>
                                                </td>
                                                <td>@(node.Department?.Name ?? "未归属")</td>
                                                <td>
                                                    <span class="view-mode">@node.Title</span>
                                                    <input type="text" name="Title" value="@node.Title" form="node-edit-form-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                </td>
                                                <td>
                                                    <span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                    <input type="date" name="PlanStartTime" value="@(node.PlanStartTime?.ToString("yyyy-MM-dd"))" form="node-edit-form-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                    <span class="view-mode"> / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                    <input type="date" name="PlanEndTime" value="@(node.PlanEndTime?.ToString("yyyy-MM-dd"))" form="node-edit-form-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                </td>
                                                <td>
                                                    <div class="progress" style="height:18px;">
                                                        <div class="progress-bar bg-success node-progress-bar-@node.ProjectNodeId" role="progressbar" style="width: @node.CompletionProgress%;" data-node-id="@node.ProjectNodeId" aria-valuenow="@node.CompletionProgress" aria-valuemin="0" aria-valuemax="100">@node.CompletionProgress.ToString("0.##")%</div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="view-mode">@node.Remark</span>
                                                    <input type="text" name="Remark" value="@node.Remark" form="node-edit-form-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                </td>
                                                <td class="node-actions">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-edit" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>编辑</button>
                                                    <button type="submit" form="node-edit-form-@node.ProjectNodeId" class="btn btn-sm btn-outline-primary d-none btn-save" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>保存</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                    <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-all-@node.ProjectNodeId">二级节点@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                    <button type="submit" form="node-delete-form-@node.ProjectNodeId" class="btn btn-sm btn-outline-danger" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled") onclick="return confirm('确定删除节点【@node.Title】吗？');">删除</button>
                                                </td>
                                            </tr>
                                            <tr id="subnode-all-@node.ProjectNodeId" class="subnode-row d-none">
                                                <td colspan="7" class="bg-light">
                                                    <div class="subnode-box p-3">
                                                        <form asp-action="AddSubNode" method="post" class="form-row mb-2 subnode-add-form align-items-end">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                            <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                            <div class="form-group col-md-2 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">二级节点名称</label>
                                                                <input type="text" name="Title" class="form-control form-control-sm" placeholder="二级节点名称" required />
                                                            </div>
                                                            <div class="form-group col-md-3 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">明细（三级节点）</label>
                                                                <input type="text" name="Detail" class="form-control form-control-sm" placeholder="明细（三级节点）" />
                                                            </div>                                                          
                                                            <div class="form-group col-md-2 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">计划开始时间</label>
                                                                <input type="date" name="PlanStartTime" class="form-control form-control-sm" />
                                                            </div>
                                                            <div class="form-group col-md-2 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">计划完成时间</label>
                                                                <input type="date" name="PlanEndTime" class="form-control form-control-sm" />
                                                            </div>
                                                            <div class="form-group col-md-1 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">状态</label>
                                                                <select name="ProgressStatus" class="custom-select custom-select-sm">
                                                                    <option>未开始</option>
                                                                    <option>进行中</option>
                                                                    <option>已完成</option>
                                                                    <option>已延期</option>
                                                                </select>
                                                            </div>
                                                            <div class="form-group col-md-2 mb-0">
                                                                <label class="small text-muted mb-1 font-weight-bold">备注（可选）</label>
                                                                <input type="text" name="Remark" class="form-control form-control-sm" placeholder="备注（可选）" />
                                                            </div>
                                                            <div class="col-md-12 mt-2">
                                                                <button type="submit" class="btn btn-sm btn-primary" @(node.DepartmentId == currentUserDepartmentId ? null : "disabled")>+ 新增子节点</button>
                                                            </div>
                                                        </form>
                                                        @if (node.SubNodes != null && node.SubNodes.Any())
                                                        {
                                                            <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                <thead><tr><th style="width:60px;">ID</th><th style="width:200px;">二级节点名称</th><th style="width:250px;">明细（三级节点）</th><th style="width:180px;">计划开始/完成</th><th style="width:80px;">状态</th><th style="width:180px;">备注</th><th style="width:200px;">操作</th></tr></thead>
                                                                <tbody>
                                                                    @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                    {
                                                                        <tr class="subnode-item-row" data-subnode-id="@subNode.ProjectSubNodeId">
                                                                            <td>
                                                                                @subNode.ProjectSubNodeId
                                                                                <form id="subnode-edit-form-@subNode.ProjectSubNodeId" asp-action="UpdateSubNode" method="post" class="subnode-edit-form" style="display:none;">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                                    <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                                    <input type="hidden" name="ProjectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                                </form>
                                                                                <form id="subnode-delete-form-@subNode.ProjectSubNodeId" asp-action="DeleteSubNode" method="post" class="subnode-delete-form" style="display:none;">
                                                                                    @Html.AntiForgeryToken()
                                                                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                                                                    <input type="hidden" name="projectNodeId" value="@node.ProjectNodeId" />
                                                                                    <input type="hidden" name="projectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                                </form>
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@subNode.Title</span>
                                                                                <input type="text" name="Title" value="@subNode.Title" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</span>
                                                                                <input type="text" name="Detail" value="@subNode.Detail" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                <input type="date" name="PlanStartTime" value="@(subNode.PlanStartTime?.ToString("yyyy-MM-dd"))" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                                                <span class="view-mode"> / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                <input type="date" name="PlanEndTime" value="@(subNode.PlanEndTime?.ToString("yyyy-MM-dd"))" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@subNode.ProgressStatus</span>
                                                                                <select name="ProgressStatus" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="custom-select custom-select-sm edit-mode d-none">
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "未开始")">未开始</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "进行中")">进行中</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "已完成")">已完成</option>
                                                                                    <option selected="@(subNode.ProgressStatus.ToString() == "已延期")">已延期</option>
                                                                                </select>
                                                                            </td>
                                                                            <td>
                                                                                <span class="view-mode">@subNode.Remark</span>
                                                                                <input type="text" name="Remark" value="@subNode.Remark" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                            </td>
                                                                            <td>
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-edit" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled")>编辑</button>
                                                                                <button type="submit" form="subnode-edit-form-@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-primary d-none btn-save" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled")>保存</button>
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                                                <button type="submit" form="subnode-delete-form-@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-danger" @(subNode.DepartmentId == currentUserDepartmentId ? null : "disabled") onclick="return confirm('确定删除子节点【@subNode.Title】吗？');">删除</button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "current-dept" ? "show active" : "")" id="current-dept" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 当前部门</div>
                        <div class="card-body p-0">
                            @if (departmentNodes.Any())
                            {
                                <div class="table-responsive project-table-wrap">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:60px;">ID</th>
                                                <th style="width:160px;">所属部门</th>
                                                <th style="width:200px;">节点名称</th>
                                                <th style="width:200px;">计划开始/完成</th>
                                                <th style="width:220px;">完成进度</th>
                                                <th style="width:180px;">备注</th>
                                                <th style="width:280px;">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var node in departmentNodes)
                                            {
                                                <tr>
                                                    <td>
                                                        @node.ProjectNodeId
                                                        <form id="node-edit-form-dept-@node.ProjectNodeId" asp-action="UpdateNode" method="post" class="node-edit-form" style="display:none;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                            <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                        </form>
                                                        <form id="node-delete-form-dept-@node.ProjectNodeId" asp-action="DeleteNode" method="post" class="node-delete-form" style="display:none;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                            <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                        </form>
                                                    </td>
                                                    <td>@(node.Department?.Name ?? "未归属")</td>
                                                    <td>
                                                        <span class="view-mode">@node.Title</span>
                                                        <input type="text" name="Title" value="@node.Title" form="node-edit-form-dept-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td>
                                                        <span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanStartTime" value="@(node.PlanStartTime?.ToString("yyyy-MM-dd"))" form="node-edit-form-dept-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                        <span class="view-mode"> / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                        <input type="date" name="PlanEndTime" value="@(node.PlanEndTime?.ToString("yyyy-MM-dd"))" form="node-edit-form-dept-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td>
                                                        <div class="progress" style="height:18px;">
                                                            <div class="progress-bar bg-success node-progress-bar-@node.ProjectNodeId" role="progressbar" style="width: @node.CompletionProgress%;" data-node-id="@node.ProjectNodeId" aria-valuenow="@node.CompletionProgress" aria-valuemin="0" aria-valuemax="100">@node.CompletionProgress.ToString("0.##")%</div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="view-mode">@node.Remark</span>
                                                        <input type="text" name="Remark" value="@node.Remark" form="node-edit-form-dept-@node.ProjectNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                    </td>
                                                    <td class="node-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-edit">编辑</button>
                                                        <button type="submit" form="node-edit-form-dept-@node.ProjectNodeId" class="btn btn-sm btn-outline-primary d-none btn-save">保存</button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                        <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-current-@node.ProjectNodeId">二级节点@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                        <button type="submit" form="node-delete-form-dept-@node.ProjectNodeId" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除节点【@node.Title】吗？');">删除</button>
                                                    </td>
                                                </tr>
                                                <tr id="subnode-current-@node.ProjectNodeId" class="subnode-row d-none">
                                                    <td colspan="7" class="bg-light">
                                                        <div class="subnode-box p-3">
                                                            <form asp-action="AddSubNode" method="post" class="form-row mb-2 subnode-add-form align-items-end">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                <div class="form-group col-md-2 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">二级节点名称</label>
                                                                    <input type="text" name="Title" class="form-control form-control-sm" placeholder="二级节点名称" required />
                                                                </div>
                                                                <div class="form-group col-md-3 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">明细（三级节点）</label>
                                                                    <input type="text" name="Detail" class="form-control form-control-sm" placeholder="明细（三级节点）" />
                                                                </div>
                                                                <div class="form-group col-md-2 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">计划开始时间</label>
                                                                    <input type="date" name="PlanStartTime" class="form-control form-control-sm" />
                                                                </div>
                                                                <div class="form-group col-md-2 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">计划完成时间</label>
                                                                    <input type="date" name="PlanEndTime" class="form-control form-control-sm" />
                                                                </div>
                                                                <div class="form-group col-md-1 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">状态</label>
                                                                    <select name="ProgressStatus" class="custom-select custom-select-sm">
                                                                        <option>未开始</option>
                                                                        <option>进行中</option>
                                                                        <option>已完成</option>
                                                                        <option>已延期</option>
                                                                    </select>
                                                                </div>
                                                                <div class="form-group col-md-2 mb-0">
                                                                    <label class="small text-muted mb-1 font-weight-bold">备注（可选）</label>
                                                                    <input type="text" name="Remark" class="form-control form-control-sm" placeholder="备注（可选）" />
                                                                </div>
                                                                <div class="col-md-12 mt-2">
                                                                    <button type="submit" class="btn btn-sm btn-primary">+ 新增子节点</button>
                                                                </div>
                                                            </form>
                                                            @if (node.SubNodes != null && node.SubNodes.Any())
                                                            {
                                                                <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                    <thead><tr><th style="width:60px;">ID</th><th style="width:200px;">二级节点名称</th><th style="width:250px;">明细（三级节点）</th><th style="width:180px;">计划开始/完成</th><th style="width:80px;">状态</th><th style="width:180px;">备注</th><th style="width:200px;">操作</th></tr></thead>
                                                                    <tbody>
                                                                        @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                        {
                                                                            <tr class="subnode-item-row" data-subnode-id="@subNode.ProjectSubNodeId">
                                                                                <td>
                                                                                    @subNode.ProjectSubNodeId
                                                                                    <form id="subnode-edit-form-dept-@subNode.ProjectSubNodeId" asp-action="UpdateSubNode" method="post" class="subnode-edit-form" style="display:none;">
                                                                                        @Html.AntiForgeryToken()
                                                                                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                                                                        <input type="hidden" name="ProjectNodeId" value="@node.ProjectNodeId" />
                                                                                        <input type="hidden" name="ProjectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                                    </form>
                                                                                    <form id="subnode-delete-form-dept-@subNode.ProjectSubNodeId" asp-action="DeleteSubNode" method="post" class="subnode-delete-form" style="display:none;">
                                                                                        @Html.AntiForgeryToken()
                                                                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                                                                        <input type="hidden" name="projectNodeId" value="@node.ProjectNodeId" />
                                                                                        <input type="hidden" name="projectSubNodeId" value="@subNode.ProjectSubNodeId" />
                                                                                    </form>
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@subNode.Title</span>
                                                                                    <input type="text" name="Title" value="@subNode.Title" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</span>
                                                                                    <input type="text" name="Detail" value="@subNode.Detail" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                    <input type="date" name="PlanStartTime" value="@(subNode.PlanStartTime?.ToString("yyyy-MM-dd"))" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                                                    <span class="view-mode"> / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span>
                                                                                    <input type="date" name="PlanEndTime" value="@(subNode.PlanEndTime?.ToString("yyyy-MM-dd"))" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" />
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@subNode.ProgressStatus</span>
                                                                                    <select name="ProgressStatus" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="custom-select custom-select-sm edit-mode d-none">
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "未开始")">未开始</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "进行中")">进行中</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "已完成")">已完成</option>
                                                                                        <option selected="@(subNode.ProgressStatus.ToString() == "已延期")">已延期</option>
                                                                                    </select>
                                                                                </td>
                                                                                <td>
                                                                                    <span class="view-mode">@subNode.Remark</span>
                                                                                    <input type="text" name="Remark" value="@subNode.Remark" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="form-control form-control-sm edit-mode d-none" style="width:100%;margin:0;" />
                                                                                </td>
                                                                                <td>
                                                                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-edit">编辑</button>
                                                                                    <button type="submit" form="subnode-edit-form-dept-@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-primary d-none btn-save">保存</button>
                                                                                    <button type="button" class="btn btn-sm btn-outline-secondary d-none btn-cancel">取消</button>
                                                                                    <button type="submit" form="subnode-delete-form-dept-@subNode.ProjectSubNodeId" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除子节点【@subNode.Title】吗？');">删除</button>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-muted">当前部门暂无一级节点。</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade @(activeTab == "other-dept" ? "show active" : "")" id="other-dept" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-header bg-light">项目一级节点 / 其他部门</div>
                        <div class="card-body p-0">
                            @if (otherDepartmentNodes.Any())
                            {
                                <div class="table-responsive project-table-wrap">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:60px;">ID</th>
                                                <th style="width:160px;">所属部门</th>
                                                <th style="width:200px;">节点名称</th>
                                                <th style="width:200px;">计划开始/完成</th>
                                                <th style="width:180px;">备注</th>
                                                <th style="width:280px;">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var node in otherDepartmentNodes)
                                            {
                                                <tr>
                                                    <td>@node.ProjectNodeId</td>
                                                    <td>@(node.Department?.Name ?? "未归属")</td>
                                                    <td><span class="view-mode">@node.Title</span></td>
                                                    <td><span class="view-mode">@(node.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-") / @(node.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                                                    <td><span class="view-mode">@node.Remark</span></td>
                                                    <td class="node-actions">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>编辑</button>
                                                        <button type="button" class="btn btn-sm btn-outline-info btn-subnode-toggle" data-target="#subnode-other-@node.ProjectNodeId">二级节点@(node.SubNodes != null && node.SubNodes.Any() ? $"（{node.SubNodes.Count}）" : "")</button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled>删除</button>
                                                    </td>
                                                </tr>
                                                <tr id="subnode-other-@node.ProjectNodeId" class="subnode-row d-none">
                                                    <td colspan="6" class="bg-light">
                                                        <div class="subnode-box p-3">
                                                            @if (node.SubNodes != null && node.SubNodes.Any())
                                                            {
                                                                <table class="table table-sm table-bordered mb-0 subnode-table">
                                                                    <thead><tr><th style="width:60px;">ID</th><th style="width:200px;">二级节点名称</th><th style="width:250px;">明细（三级节点）</th><th style="width:120px;">计划开始/完成</th><th style="width:80px;">状态</th><th style="width:180px;">备注</th></tr></thead>
                                                                    <tbody>
                                                                        @foreach (var subNode in node.SubNodes.OrderBy(sn => sn.ProjectSubNodeId))
                                                                        {
                                                                            <tr class="subnode-item-row">
                                                                                <td>@subNode.ProjectSubNodeId</td>
                                                                                <td>@subNode.Title</td>
                                                                                <td>@(string.IsNullOrWhiteSpace(subNode.Detail) ? "-" : subNode.Detail)</td>
                                                                                <td>@(subNode.PlanStartTime?.ToString("yyyy-MM-dd") ?? "-") / @(subNode.PlanEndTime?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                                                <td>@subNode.ProgressStatus</td>
                                                                                <td>@subNode.Remark</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small subnode-empty">暂无子节点。</div>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-muted">暂无其他部门一级节点。</div>
                            }
                        </div>
                    </div>
                </div>


            </div>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addNodeModal" @(currentUserDepartmentId.HasValue ? null : "disabled")>+ 新增节点</button>
            <div class="alert alert-info mb-0">当前项目暂无一级节点，可在上方新增。</div>
        }
    </div>
</div>

@section Style {
    <link href="~/css/project-plan-index.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/projectplan/Project.js"></script>
}

<div class="modal fade" id="addNodeModal" tabindex="-1" role="dialog" aria-labelledby="addNodeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="AddNode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addNodeModalLabel">新增一级节点</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group"><label>一级节点名称</label><input type="text" name="Title" class="form-control" required /></div>
                    <div class="form-row"><div class="col"><label>计划开始日期</label><input type="date" name="PlanStartTime" class="form-control" /></div><div class="col"><label>计划结束日期</label><input type="date" name="PlanEndTime" class="form-control" /></div></div>
                    <div class="form-group"><label>备注</label><input type="text" name="Remark" class="form-control" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">取消</button><button type="submit" class="btn btn-primary">新增节点</button></div>
            </form>
        </div>
    </div>
</div>
