@model SkylinePlanManagementSystem.ViewModels.ProjectPlan.ProjectCreateViewModel
@{
    ViewBag.Title = "添加项目";
}

<h1>添加项目</h1>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group row">
        <label asp-for="ProjectName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ProjectName" class="form-control" placeholder="请输入项目名称" />
            <span asp-validation-for="ProjectName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Remark" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="请输入备注（可选）"></textarea>
            <span asp-validation-for="Remark" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="StartTime" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="StartTime" type="date" class="form-control" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <label asp-for="EndTime" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="EndTime" type="date" class="form-control" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Status" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="custom-select mr-sm-2"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">创建</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">返回列表</a>
        </div>
    </div>
</form>

