@using SkylinePlanManagementSystem.Application.Dtos;
@model PagedResultDto<Project>

@{
    ViewBag.Title = "项目列表";
}

<div class="project-list-page">
    @if(TempData["ProjectError"] != null)
    {
        <div class="alert alert-warning">@TempData["ProjectError"]</div>
    }
    @if(TempData["ProjectSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["ProjectSuccess"]</div>
    }
    <div class="project-header d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">项目列表</h3>
            <p class="text-muted mb-0">共 @Model.TotalCount 个项目</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3">
            + 新建项目
        </a>
    </div>

    <form asp-action="Index" method="get" class="project-search-box mb-3">

        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
        <input type="hidden" name="Sorting" value="@Model.Sorting" />

        <div class="input-group">

            <input type="text"
                   name="FilterText"
                   value="@Model.FilterText"
                   class="form-control"
                   placeholder="请输入项目名称或备注..." />

            <div class="input-group-append">

                <button type="submit" class="btn btn-outline-primary">
                    搜索
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    重置
                </a>

            </div>
        </div>
    </form>



    @if (Model.Data.Any())
    {
        <div class="table-responsive project-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>项目ID</th>

                        <th>
                            项目名称
                            <a asp-action="Index"
                               asp-route-Sorting="ProjectName"
                               asp-route-CurrentPage="@Model.CurrentPage"
                               asp-route-FilterText="@Model.FilterText">
                                ↑
                            </a>

                            <a asp-action="Index"
                               asp-route-Sorting="ProjectName desc"
                               asp-route-CurrentPage="@Model.CurrentPage"
                               asp-route-FilterText="@Model.FilterText">
                                ↓
                            </a>
                        </th>

                        <th>开始时间</th>

                        <th>结束时间</th>

                        <th>备注</th>

                        <th>状态</th>

                        <th style="width:220px;">项目进度</th>

                        <th width="220">操作</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var project in Model.Data)
                    {
                        <tr>
                            <td>@project.ProjectId</td>

                            <td class="font-weight-bold">@project.ProjectName</td>

                            <td>@(project.StartTime?.ToString("yyyy-MM-dd") ?? "-")</td>

                            <td>@(project.EndTime?.ToString("yyyy-MM-dd") ?? "-")</td>

                            <td class="text-muted">@(string.IsNullOrWhiteSpace(project.Remark) ? "-" : project.Remark)</td>

                            <td>
                                <span class="badge badge-light border">@project.Status</span>
                            </td>

                            <td>
                                <div class="progress" style="height:18px;">
                                    <div class="progress-bar" role="progressbar" style="width: @project.CompletionProgress%;" aria-valuenow="@project.CompletionProgress" aria-valuemin="0" aria-valuemax="100">@project.CompletionProgress.ToString("0.##")%</div>
                                </div>
                            </td>

                            <td>
                                <a class="btn btn-sm btn-outline-info"
                                   asp-action="Project"
                                   asp-route-id="@project.ProjectId">
                                    项目视图
                                </a>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Edit"
                                   asp-route-id="@project.ProjectId">
                                    编辑
                                </a>

                                <form asp-action="Delete" asp-route-id="@project.ProjectId" method="post" class="d-inline ml-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('确定要删除项目【@project.ProjectName】吗？');">
                                        删除
                                    </button>
                                </form>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-0">
            暂无项目数据
        </div>
    }



    <!-- 分页 -->
    <nav class="mt-3">
        <ul class="pagination justify-content-center mb-0">

            <li class="page-item @(!Model.ShowFirst ? "disabled" : "")">
                <a class="page-link"
                   asp-route-CurrentPage="1"
                   asp-route-FilterText="@Model.FilterText"
                   asp-route-Sorting="@Model.Sorting">
                    首页
                </a>
            </li>

            <li class="page-item @(!Model.ShowPrevious ? "disabled" : "")">
                <a class="page-link"
                   asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                   asp-route-FilterText="@Model.FilterText"
                   asp-route-Sorting="@Model.Sorting">
                    上一页
                </a>
            </li>


            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-route-CurrentPage="@i"
                       asp-route-FilterText="@Model.FilterText"
                       asp-route-Sorting="@Model.Sorting">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(!Model.ShowNext ? "disabled" : "")">
                <a class="page-link"
                   asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                   asp-route-FilterText="@Model.FilterText"
                   asp-route-Sorting="@Model.Sorting">
                    下一页
                </a>
            </li>

            <li class="page-item @(!Model.ShowLast ? "disabled" : "")">
                <a class="page-link"
                   asp-route-CurrentPage="@Model.TotalPages"
                   asp-route-FilterText="@Model.FilterText"
                   asp-route-Sorting="@Model.Sorting">
                    末页
                </a>
            </li>

        </ul>
    </nav>
</div>

@section Style {
    <link href="~/css/project-plan-index.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/CustomScript.js" asp-append-version="true"></script>
}
