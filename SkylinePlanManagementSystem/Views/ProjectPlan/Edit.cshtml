@model SkylinePlanManagementSystem.ViewModels.ProjectPlan.ProjectCreateViewModel
@{
    ViewBag.Title = "编辑项目";
    var nodes = ViewBag.ProjectNodes as List<ProjectNode> ?? new List<ProjectNode>();
}

<h1>编辑项目</h1>

<form asp-action="Edit" method="post" class="mt-3">
    <input asp-for="ProjectId" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group row">
        <label asp-for="ProjectName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ProjectName" class="form-control" placeholder="请输入项目名称" />
            <span asp-validation-for="ProjectName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Remark" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="请输入备注（可选）"></textarea>
            <span asp-validation-for="Remark" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="StartTime" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="StartTime" type="date" class="form-control" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <label asp-for="EndTime" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-4">
            <input asp-for="EndTime" type="date" class="form-control" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Status" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="custom-select mr-sm-2"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">保存</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">返回列表</a>
        </div>
    </div>
</form>

<hr />
<h4>项目一级节点</h4>

@if (TempData["ProjectNodeError"] != null)
{
    <div class="alert alert-danger">@TempData["ProjectNodeError"]</div>
}

<form asp-action="AddNode" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
    <div class="form-row">
        <div class="col-md-5">
            <input type="text" name="Title" class="form-control" placeholder="节点名称，如：前期准备" required />
        </div>
        <div class="col-md-3">
            <input type="date" name="PlanTime" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary">+ 新增节点</button>
        </div>
    </div>
</form>

@if (nodes.Any())
{
    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>ID</th>
                <th>节点名称</th>
                <th>计划时间</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var node in nodes.OrderBy(n => n.ProjectNodeId))
            {
                <tr>
                    <td>@node.ProjectNodeId</td>
                    <td>@node.Title</td>
                    <td>@(node.PlanTime?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">当前项目还没有一级节点，请先新增。</div>
}
