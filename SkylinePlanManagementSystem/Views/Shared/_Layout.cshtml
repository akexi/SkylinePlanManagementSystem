<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/lib/twitter-bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/_Layoutsite.css" rel="stylesheet" />
    <link href="~/iconfont/font_5169369_4ex6qd0dral/iconfont.css" rel="stylesheet" />
    @RenderSection("Style", required: false)
    <title>@ViewBag.Title</title>
</head>

<style>

    .layout-footer {
        
    }

    .icon {
        width: 1em;
        height: 1em;
        vertical-align: -0.15em;
        fill: currentColor;
        overflow: hidden;
    }
</style>

<body>

    @inject SignInManager<ApplicationUser> _signInManager
    @inject UserManager<ApplicationUser> _userManager

    <nav class="navbar navbar-expand-sm navbar-light bg-white">
        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center"
               asp-controller="home"
               asp-action="NewIndex">
                <img src="~/images/horon.png" width="120" />
                <span class="ml-2 font-weight-bold">
                    计划填报系统
                </span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-toggle="collapse"
                    data-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="collapsibleNavbar">

                <!-- 左侧菜单 -->
                <ul class="navbar-nav">
                    @if (_signInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="NewIndex">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-shouye"></use>
                                </svg>
                                首页
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ProjectPlan"
                               asp-action="Index">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-hetongleixing-L"></use>
                                </svg>
                                项目计划
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="ComingSoon">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-yewubaobiao"></use>
                                </svg>
                                部门工作部署
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="ComingSoon">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-xinxijilu"></use>
                                </svg>
                                部门工作评分
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="ComingSoon">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-shujufenxi"></use>
                                </svg>
                                统计查询
                            </a>
                        </li>
                    }  

                    <!-- 系统管理菜单：仅管理员可见 -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-yusuantiaozheng"></use>
                                </svg>
                                系统管理
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Departments" asp-action="Index">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-jigoubianzhi"></use>
                                    </svg>
                                    部门管理
                                </a>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="ListUsers">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-yonghuguanli"></use>
                                    </svg>
                                    用户管理
                                </a>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="ListRoles">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-jiaoseguanli"></use>
                                    </svg>
                                    角色管理
                                </a>
                            </div>
                        </li>
                    }

                </ul>

                <!-- 右侧用户 -->
                <ul class="navbar-nav ml-auto">

                    @if (_signInManager.IsSignedIn(User))
                    {
                        var appUser = await _userManager.GetUserAsync(User);

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-toggle="dropdown">
                                @appUser.Name
                                <svg class="icon" aria-hidden="true">
                                    <use xlink:href="#icon-yusuanguanli"></use>
                                </svg>
                            </a>

                            <div class="dropdown-menu dropdown-menu-right">
                                <!-- 用户相关功能 -->
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-hetongshenpi"></use>
                                    </svg>
                                    用户中心
                                </a>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="ChangePassword">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-jiaoseguanli"></use>
                                    </svg>
                                    修改密码
                                </a>
                                <a class="dropdown-item"
                                   asp-controller="Home"
                                   asp-action="About">
                                    <svg class="icon" aria-hidden="true">
                                        <use xlink:href="#icon-hetongxinxi"></use>
                                    </svg>
                                    关于
                                </a>

                                <div class="dropdown-divider"></div>

                                <form method="post"
                                      asp-controller="account"
                                      asp-action="logout">

                                    <button type="submit"class="dropdown-item">
                                        <svg class="icon" aria-hidden="true">
                                            <use xlink:href="#icon-tuichu"></use>
                                        </svg>
                                        退出登录
                                    </button>

                                </form>

                            </div>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="home"
                               asp-action="NewIndex">
                                登录
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>


    <!-- 主体内容 -->
    <div class="container-fluid main-container">
        <div class="content-card">
            @RenderBody()
        </div>
    </div>

    <div style="position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        text-align: center;
        padding: 10px 0;
        color: #999;
        font-size: 13px;
        background: #fff;
        border-top: 1px solid #eee;">
        © 2026 计划填报系统 · 西双版纳可见旅游发展有限公司 · 综合管理部
    </div>


    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/jquery-validate/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/iconfont/font_5169369_4ex6qd0dral/iconfont.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>