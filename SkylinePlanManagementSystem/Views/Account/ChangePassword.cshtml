@using SkylinePlanManagementSystem.ViewModels.Account
@model ChangePasswordViewModel
@{
    ViewBag.Title = "修改密码";
}

<div class="container mt-4 mb-5">

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <svg class="icon" aria-hidden="true">
                        <use xlink:href="#icon-jiaoseguanli"></use>
                    </svg>
                    修改密码
                </h5>
                <span class="text-muted">账户安全</span>
            </div>
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row mb-3">
                    <label asp-for="CurrentPassword"
                           class="col-sm-2 col-form-label"></label>

                    <div class="col-sm-6">
                        <input asp-for="CurrentPassword"
                               class="form-control"
                               type="password"
                               placeholder="请输入当前密码" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="NewPassword"
                           class="col-sm-2 col-form-label"></label>

                    <div class="col-sm-6">
                        <input asp-for="NewPassword"
                               class="form-control"
                               type="password"
                               placeholder="请输入新密码" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="ConfirmPassword"
                           class="col-sm-2 col-form-label"></label>

                    <div class="col-sm-6">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               type="password"
                               placeholder="请再次输入新密码" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit"
                            class="btn btn-primary">
                        更新密码
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>